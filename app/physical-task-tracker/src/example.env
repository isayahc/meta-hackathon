# Copy what you need into the environment. Anything missing is prompted for
# interactively (the API key is typed blind and can be remembered outside
# the repo). Never put a real key in this file.
# META_API_KEY=
# META_API_BASE=https://api.meta.ai/v1
# MUSE_MODEL=muse-spark-1.1
# MAX_TOKENS=4096
# REASONING_EFFORT=low
# OI_ROOT=C:\path\to\OpenIndustries
# OI_SCENE_DATA_DIR=
# OI_WORKBENCH_ORIGIN=http://127.0.0.1:5173
# OI_STRICT_PIN=true
