{
  "name": "field-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Field Ops — phone-first farm-operations task tracker (TypeScript).",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prestart": "npm run build",
    "start": "node dist/serve-dashboard.js ./my-farm --port 8123 --open",
    "test": "npm run build && node --test dist/*.test.js dist/lib/*.test.js",
    "dataset:floorplan-web-10": "node datasets/floorplan-web-10/run.mjs",
    "dataset:render-floorplan-web-10": "node datasets/floorplan-web-10/render.mjs"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
