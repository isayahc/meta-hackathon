# Field Ops — example environment (placeholders only, never a real key).
# Copy what you need into your shell, e.g.:
#   $env:META_API_KEY = "<paste-key-here>"   # PowerShell
#   export META_API_KEY=<paste-key-here>      # bash
# Anything missing is prompted for interactively (typed blind) and can be
# remembered outside the repo at %APPDATA%\meta-hackathon\demo-key.json.
# The full source of truth lives at src/example.env (copied to dist/).

# META_API_KEY=
# META_API_BASE=https://api.meta.ai/v1
# MUSE_MODEL=muse-spark-1.1
# MAX_TOKENS=4096
# REASONING_EFFORT=low
# WALKTHROUGH_PYTHON=/absolute/path/inference-venv/bin/python
# WALKTHROUGH_DEVICE=cuda
# MAPANYTHING_ROOT=/absolute/path/map-anything
# SAM3_ROOT=/absolute/path/sam3
# MAPANYTHING_REVISION=<exact-cached-checkpoint-commit>
# SAM3_REVISION=<exact-cached-checkpoint-commit>
